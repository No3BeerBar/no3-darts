# Optional — protect camera / match write APIs
CAMERA_API_KEY=

# ── Player accounts (name + PIN) ────────────────────────────────────────────
# REQUIRED on the Railway **no3-darts** service for register/login + shared stats.
# Point this at the project's Postgres plugin, e.g. Railway reference:
#   DATABASE_URL=${{Postgres.DATABASE_URL}}
# Without it, guests and localStorage still work; auth APIs return 503.
# Verify after deploy: GET /api/health → database.available === true
DATABASE_URL=

# HMAC secret for httpOnly player session cookies (recommended in production)
# Generate: openssl rand -hex 32
SESSION_SECRET=

# 4-digit staff PIN for Admin APIs (player PIN reset). Default 1234 if unset.
# Keep matched with Admin → Staff PIN used for /play unlock on tablets.
STAFF_PIN=
